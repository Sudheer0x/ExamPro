# ExamPro frontend settings. Copy to .env if you need to change anything. No secrets belong here:
# everything in a Vite .env file is visible to anyone who opens the site.

# How the browser reaches the backend API.
#   /api (default)  -> goes through the Vite dev-server proxy (see vite.config.js); no backend CORS change needed.
#   a full URL      -> talks to the backend directly, e.g. http://localhost:5000/api
#                      (then add this site's origin, e.g. http://localhost:5173, to CORS_ORIGINS in the BACKEND's .env).
VITE_API_BASE_URL=/api

# Where the dev-server proxy forwards /api (development only).
VITE_PROXY_TARGET=http://localhost:5000
