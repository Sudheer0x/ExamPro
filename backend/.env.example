# ==================================================
# ExamPro — Environment Configuration Template
# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to GitHub.
# ==================================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- MySQL Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=exampro_db

# ---------- Auth ----------
# Used to sign JWTs for the centralized exam-portal login (Phase 8)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=2h

# Phase 2 — normal login (students + staff)
# Short-lived access token; the refresh token (HttpOnly cookie) lasts REFRESH_TOKEN_DAYS.
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
# Optional separate key for hashing OTPs (defaults to a value derived from JWT_SECRET).
# OTP_HMAC_SECRET=another_long_random_string

# Used to sign the admin/teacher/invigilator dashboard session cookie
SESSION_SECRET=change_this_to_a_different_long_random_string

# ---------- Email (Nodemailer) ----------
# Example values for Gmail SMTP — use an "app password", not your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="ExamPro <no-reply@exampro.com>"

# ---------- OTP ----------
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- CORS / rate limiting / proxy (Phase 2) ----------
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5000,http://localhost:3000,http://127.0.0.1:5000
# Set to true ONLY while testing locally to switch rate limits off (ignored in production).
RATE_LIMIT_DISABLED=false
# Set to true if the app runs behind a reverse proxy (nginx, a cloud load balancer, ...).
# TRUST_PROXY=false
