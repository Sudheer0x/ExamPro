{
  "name": "exampro-backend",
  "version": "1.0.0",
  "description": "ExamPro - Centralized Computer-Based Examination Management System (backend)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:staff": "node scripts/seedStaff.js",
