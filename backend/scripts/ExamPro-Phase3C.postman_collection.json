{
  "info": {
    "name": "ExamPro - Phase 3C (student exam discovery + registration)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folder 0, then 1 (as admin, creates the data), then 2 and 3 as the student. Set adminEmail/adminPassword and studentEmail/studentPassword (a verified student) in the collection variables."
  },
  "variable": [
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "studentEmail",
      "value": ""
    },
    {
      "key": "studentPassword",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "examId",
      "value": ""
    },
    {
      "key": "centerId",
      "value": ""
    },
    {
      "key": "slotId",
      "value": ""
    },
    {
      "key": "registrationId",
      "value": ""
    },
    {
      "key": "base",
      "value": "http://localhost:5000/api"
    }
  ],
  "item": [
    {
      "name": "0. Logins (run first)",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\",\n  \"account_type\": \"staff\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login ok', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\",\n  \"account_type\": \"student\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login ok', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('studentToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Setup as admin (creates the data the student sees)",
      "item": [
        {
          "name": "Create exam",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/examinations",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "examinations"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exam_name\": \"Postman 3C exam\",\n  \"registration_start_date\": \"2026-10-01 09:00:00\",\n  \"registration_end_date\": \"2026-11-30 23:59:59\",\n  \"exam_duration_minutes\": 180,\n  \"fee\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set('examId', pm.response.json().data.examination.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create center",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/centers",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "centers"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"center_name\": \"Postman 3C centre\",\n  \"city\": \"Vijayawada\",\n  \"state\": \"Andhra Pradesh\",\n  \"address\": \"Test road\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set('centerId', pm.response.json().data.center.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create 20 PCs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/centers/{{centerId}}/computers",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "centers",
                "{{centerId}}",
                "computers"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"count\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create slot (2 seats)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/examinations/{{examId}}/slots",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "examinations",
                "{{examId}}",
                "slots"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"center_id\": {{centerId}},\n  \"exam_date\": \"2026-12-14\",\n  \"slot_start_time\": \"09:00\",\n  \"slot_end_time\": \"12:30\",\n  \"capacity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set('slotId', pm.response.json().data.slot.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Open registration",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/examinations/{{examId}}/status",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "examinations",
                "{{examId}}",
                "status"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"registration_open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Student: discover",
      "item": [
        {
          "name": "List exams",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/exam?page=1&limit=20",
              "host": [
                "{{base}}"
              ],
              "path": [
                "exam?page=1&limit=20"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "List exams (search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/exam?q=Postman",
              "host": [
                "{{base}}"
              ],
              "path": [
                "exam?q=Postman"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Exam details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/exam/{{examId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "exam",
                "{{examId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Slots of the exam",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/exam/{{examId}}/slots",
              "host": [
                "{{base}}"
              ],
              "path": [
                "exam",
                "{{examId}}",
                "slots"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Slots filtered by center and date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/exam/{{examId}}/slots?center_id={{centerId}}&date=2026-12-14",
              "host": [
                "{{base}}"
              ],
              "path": [
                "exam",
                "{{examId}}",
                "slots?center_id={{centerId}}&date=2026-12-14"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Student: register and cancel",
      "item": [
        {
          "name": "Register for the slot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/registration",
              "host": [
                "{{base}}"
              ],
              "path": [
                "registration"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_id\": {{slotId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set('registrationId', pm.response.json().data.registration.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register again (expect 409 DUPLICATE_REGISTRATION)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/registration",
              "host": [
                "{{base}}"
              ],
              "path": [
                "registration"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_id\": {{slotId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Try to send a student_id (expect 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/registration",
              "host": [
                "{{base}}"
              ],
              "path": [
                "registration"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_id\": {{slotId}},\n  \"student_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "My registrations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/registration/mine?page=1&limit=20",
              "host": [
                "{{base}}"
              ],
              "path": [
                "registration",
                "mine?page=1&limit=20"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel my registration",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base}}/registration/{{registrationId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "registration",
                "{{registrationId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel again (expect 409 ALREADY_CANCELLED)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base}}/registration/{{registrationId}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "registration",
                "{{registrationId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}