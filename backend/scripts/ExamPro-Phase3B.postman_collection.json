{
  "info": {
    "name": "ExamPro - Phase 3B (exam setup)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run '0. Login' first. Set adminEmail and adminPassword in the collection variables. Requests are meant to be run in order; later ones reuse ids saved by earlier ones."
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "examId",
      "value": ""
    },
    {
      "key": "centerId",
      "value": ""
    },
    {
      "key": "pcId",
      "value": ""
    },
    {
      "key": "slotId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Login (run first)",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login ok', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Examinations",
      "item": [
        {
          "name": "Create examination",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/admin/examinations",
              "host": [
                "{{base}}"
              ],
              "path": [
                "admin",
                "examinations"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exam_name\": \"ExamPro CBT 2026\",\n  \"description\": \"Computer-based test\",\n  \"instructions\": \"Carry your hall ticket and a photo ID.\",\n  \"registration_start_date\": \"2026-10-01 09:00:00\",\n  \"registration_end_date\": \"2026-11-30 23:59:59\",\n  \"exam_duration_minutes\": 180,\n  \"fee\": 500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set('examId', pm.response.json().data.examination.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List examinations",
          "request": {
            "method": "GET",
            "header": [],
